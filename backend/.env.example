# Local or Railway backend configuration. Do not commit a real .env file.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bugtracker?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes-long
JWT_EXPIRATION=2592000000
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_FRONTEND_REDIRECT=http://localhost:5000/github-auth
ML_SERVICE_URL=http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:5000
